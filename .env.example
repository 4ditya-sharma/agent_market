# Copy to .env. Any key you leave empty just falls back to the offline mock, so the demo never breaks.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
USE_OLLAMA=0                      # 1 if Ollama is running locally
OLLAMA_BASE_URL=http://localhost:11434/v1

# provider:model  (check each provider's free-tier model list for current names)
MASTER_MODEL=groq:llama-3.3-70b-versatile
WORKER_MODEL=groq:llama-3.1-8b-instant
JUDGE_MODELS=groq:llama-3.3-70b-versatile,gemini:gemini-2.0-flash,groq:llama-3.1-8b-instant

LLM_MODE=auto                     # auto | mock
JUDGE_PASS_SCORE=6
INJECTION_THRESHOLD=0.6           # overridden by models/firewall_config.json once trained
FIREWALL_USE_TRANSFORMER=0        # 1 after running classifier/train_transformer.py
DEMO_BAD_ACTORS=1                 # register ShadyResearcher + LazyAnalyst for the demo
